{
  "categories": [
    "geolocation-!cn",
    "category-ai-!cn",
    "geolocation-cn",
    "reddit",
    "microsoft",
    "apple",
    "microsoft@cn",
    "apple@cn",
    "telegram",
    "netflix",
    "hbo",
    "disney",
    "cn",
    "paypal",
    "paypal@cn",
    "google",
    "youtube",
    "github",
    "steam",
    "steam@cn"
  ],
  "strict": true,
  "sources": [
    {
      "id": "sagernet",
      "format": "sing-box-srs",
      "url_template": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-{category}.srs"
    },
    {
      "id": "loyalsoldier",
      "format": "v2ray-geosite",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat"
    },
    {
      "id": "metacubex",
      "format": "v2ray-geosite",
      "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geosite.dat"
    },
    {
      "id": "geoip-telegram",
      "format": "sing-box-srs",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/srs/telegram.srs",
      "targets": {
        "geoip-telegram": "telegram"
      }
    },
    {
      "id": "geoip-cn",
      "format": "sing-box-srs",
      "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
      "targets": {
        "geoip-cn": "cn"
      }
    },
    {
      "id": "vpsdance-ai",
      "format": "provider-yaml-archive",
      "url": "https://codeload.github.com/VPSDance/ai-proxy-rules/tar.gz/refs/heads/main",
      "catalog": true,
      "publish": false,
      "members_glob": "data/providers/*.yaml",
      "notice_paths": [
        "LICENSE"
      ]
    }
  ],
  "aggregations": [
    {
      "target": "ai-all",
      "select": [
        {
          "source": "vpsdance-ai"
        },
        {
          "source": "*",
          "categories": [
            "category-ai-!cn"
          ]
        }
      ]
    },
    {
      "target": "ai-cn",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "scope": "cn"
          }
        }
      ]
    },
    {
      "target": "category-ai-!cn",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "scope": "global"
          }
        }
      ]
    },
    {
      "target": "ai-openai",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "provider": [
              "openai"
            ]
          }
        }
      ]
    },
    {
      "target": "ai-anthropic",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "provider": [
              "anthropic"
            ]
          }
        }
      ]
    },
    {
      "target": "ai-google",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "provider": [
              "google-ai"
            ]
          }
        }
      ]
    },
    {
      "target": "ai-microsoft",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "provider": [
              "copilot"
            ]
          }
        }
      ]
    },
    {
      "target": "ai-bytedance",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "provider": [
              "bytedance-ai",
              "bytedance-ai-cn"
            ]
          }
        }
      ]
    },
    {
      "target": "ai-alibaba",
      "select": [
        {
          "source": "vpsdance-ai",
          "where": {
            "provider": [
              "alibaba-ai"
            ]
          }
        }
      ]
    },
    {
